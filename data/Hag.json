{"1:1":{"text":"בִּשְׁנַ֤ת שְׁתַּ֨יִם֙ לְדָרְיָ֣וֶשׁ הַמֶּ֔לֶךְ בַּחֹ֨דֶשׁ֙ הַשִּׁשִּׁ֔י בְּי֥וֹם אֶחָ֖ד לַחֹ֑דֶשׁ הָיָ֨ה דְבַר יְהוָ֜ה בְּיַד חַגַּ֣י הַנָּבִ֗יא אֶל זְרֻבָּבֶ֤ל בֶּן שְׁאַלְתִּיאֵל֙ פַּחַ֣ת יְהוּדָ֔ה וְאֶל יְהוֹשֻׁ֧עַ בֶּן יְהוֹצָדָ֛ק הַכֹּהֵ֥ן הַגָּד֖וֹל לֵאמֹֽר","words":[{"t":"בִּשְׁנַ֤ת","s":"b/8141","m":"HR/Ncfsc"},{"t":"שְׁתַּ֨יִם֙","s":"8147","m":"HAcfda"},{"t":"לְדָרְיָ֣וֶשׁ","s":"l/1867","m":"HR/Np"},{"t":"הַמֶּ֔לֶךְ","s":"d/4428","m":"HTd/Ncmsa"},{"t":"בַּחֹ֨דֶשׁ֙","s":"b/2320","m":"HRd/Ncmsa"},{"t":"הַשִּׁשִּׁ֔י","s":"d/8345","m":"HTd/Aomsa"},{"t":"בְּי֥וֹם","s":"b/3117","m":"HR/Ncmsa"},{"t":"אֶחָ֖ד","s":"259","m":"HAcmsa"},{"t":"לַחֹ֑דֶשׁ","s":"l/2320","m":"HRd/Ncmsa"},{"t":"הָיָ֨ה","s":"1961","m":"HVqp3ms"},{"t":"דְבַר","s":"1697","m":"HNcmsc"},{"t":"יְהוָ֜ה","s":"3068","m":"HNp"},{"t":"בְּיַד","s":"b/3027","m":"HR/Ncbsc"},{"t":"חַגַּ֣י","s":"2292 a","m":"HNp"},{"t":"הַנָּבִ֗יא","s":"d/5030","m":"HTd/Ncmsa"},{"t":"אֶל","s":"413","m":"HR"},{"t":"זְרֻבָּבֶ֤ל","s":"2216","m":"HNp"},{"t":"בֶּן","s":"1121 a","m":"HNcmsc"},{"t":"שְׁאַלְתִּיאֵל֙","s":"7597 a","m":"HNp"},{"t":"פַּחַ֣ת","s":"6346","m":"HNcmsc"},{"t":"יְהוּדָ֔ה","s":"3063","m":"HNp"},{"t":"וְאֶל","s":"c/413","m":"HC/R"},{"t":"יְהוֹשֻׁ֧עַ","s":"3091","m":"HNp"},{"t":"בֶּן","s":"1121 a","m":"HNcmsc"},{"t":"יְהוֹצָדָ֛ק","s":"3087","m":"HNp"},{"t":"הַכֹּהֵ֥ן","s":"d/3548","m":"HTd/Ncmsa"},{"t":"הַגָּד֖וֹל","s":"d/1419 a","m":"HTd/Aamsa"},{"t":"לֵאמֹֽר","s":"l/559","m":"HR/Vqc"}]},"1:2":{"text":"כֹּ֥ה אָמַ֛ר יְהוָ֥ה צְבָא֖וֹת לֵאמֹ֑ר הָעָ֤ם הַזֶּה֙ אָֽמְר֔וּ לֹ֥א עֶת בֹּ֛א עֶת בֵּ֥ית יְהוָ֖ה לְהִבָּנֽוֹת","words":[{"t":"כֹּ֥ה","s":"3541","m":"HD"},{"t":"אָמַ֛ר","s":"559","m":"HVqp3ms"},{"t":"יְהוָ֥ה","s":"3068","m":"HNp"},{"t":"צְבָא֖וֹת","s":"6635 b","m":"HNcbpa"},{"t":"לֵאמֹ֑ר","s":"l/559","m":"HR/Vqc"},{"t":"הָעָ֤ם","s":"d/5971 a","m":"HTd/Ncmsa"},{"t":"הַזֶּה֙","s":"d/2088","m":"HTd/Pdxms"},{"t":"אָֽמְר֔וּ","s":"559","m":"HVqp3cp"},{"t":"לֹ֥א","s":"3808","m":"HTn"},{"t":"עֶת","s":"