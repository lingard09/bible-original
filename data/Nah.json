{"1:1":{"text":"מַשָּׂ֖א נִֽינְוֵ֑ה סֵ֧פֶר חֲז֛וֹן נַח֖וּם הָאֶלְקֹשִֽׁי","words":[{"t":"מַשָּׂ֖א","s":"4853 b","m":"HNcmsc"},{"t":"נִֽינְוֵ֑ה","s":"5210","m":"HNp"},{"t":"סֵ֧פֶר","s":"5612 a","m":"HNcmsc"},{"t":"חֲז֛וֹן","s":"2377","m":"HNcmsc"},{"t":"נַח֖וּם","s":"5151","m":"HNp"},{"t":"הָאֶלְקֹשִֽׁי","s":"d/512","m":"HTd/Ngmsa"}]},"1:2":{"text":"אֵ֣ל קַנּ֤וֹא וְנֹקֵם֙ יְהוָ֔ה נֹקֵ֥ם יְהוָ֖ה וּבַ֣עַל חֵמָ֑ה נֹקֵ֤ם יְהוָה֙ לְצָרָ֔יו וְנוֹטֵ֥ר ה֖וּא לְאֹיְבָֽיו","words":[{"t":"אֵ֣ל","s":"410","m":"HNcmsa"},{"t":"קַנּ֤וֹא","s":"7072","m":"HAamsa"},{"t":"וְנֹקֵם֙","s":"c/5358","m":"HC/Vqrmsa"},{"t":"יְהוָ֔ה","s":"3068","m":"HNp"},{"t":"נֹקֵ֥ם","s":"5358","m":"HVqrmsa"},{"t":"יְהוָ֖ה","s":"3068","m":"HNp"},{"t":"וּבַ֣עַל","s":"c/1167","m":"HC/Ncmsc"},{"t":"חֵמָ֑ה","s":"2534","m":"HNcfsa"},{"t":"נֹקֵ֤ם","s":"5358","m":"HVqrmsa"},{"t":"יְהוָה֙","s":"3068","m":"HNp"},{"t":"לְצָרָ֔יו","s":"l/6862 c","m":"HR/Ncmpc/Sp3ms"},{"t":"וְנוֹטֵ֥ר","s":"c/5201","m":"HC/Vqrmsa"},{"t":"ה֖וּא","s":"1931","m":"HPp3ms"},{"t":"לְאֹיְבָֽיו","s":"l/341","m":"HR/Vqrmpc/Sp3ms"}]},"1:3":{"text":"יְהֹוָ֗ה אֶ֤רֶךְ אַפַּ֨יִם֙ וגדול כֹּ֔חַ וְנַקֵּ֖ה לֹ֣א יְנַקֶּ֑ה יְהוָ֗ה בְּסוּפָ֤ה וּבִשְׂעָרָה֙ דַּרְכּ֔וֹ וְעָנָ֖ן אֲבַ֥ק רַגְלָֽיו","words":[{"t":"יְהֹוָ֗ה","s":"3068","m":"HNp"},{"t":"אֶ֤רֶךְ","s":"750","m":"HAamsc"},{"t":"אַפַּ֨יִם֙","s":"639","m":"HNcmda"},{"t":"וגדול","s":"c/1419 a","m":"HC/Aamsc"},{"t":"כֹּ֔חַ","s":"3581 b","m":"HNcmsa"},{"t":"וְנַקֵּ֖ה","s":"c/5352","m":"HC/Vpa"},{"t":"לֹ֣א","s":"3808","m":"HTn"},{"t":"יְנַקֶּ֑ה","s":"5352","m":"HVpi3ms"},{"t":"יְהוָ֗ה","s":"3068","m":"HNp"},{"t":"בְּסוּפָ֤ה","s":"b/5492 a","m":"HR/Ncfsa"},{"t":"וּבִשְׂעָרָה֙","s":"c/b/8183","m":"HC/R/Ncfsa"},{"t":"דַּרְכּ֔וֹ","s":"1870","m":"HNcbsc/Sp3ms"},{"t":"וְעָנָ֖ן","s":"c/6051","m":"HC/Ncmsa"},{"t":"אֲבַ֥ק","s":"80","m":"HNcmsc"},{"t":"רַגְלָֽיו","s":"7272","m":"HNcfdc/Sp3ms"}]},"1:4":{"text":"גּוֹעֵ֤ר בַּיָּם֙ וַֽיַּבְּשֵׁ֔הוּ וְכָל הַנְּהָר֖וֹת הֶֽחֱרִ֑יב אֻמְלַ֤ל בָּשָׁן֙ וְכַרְמֶ֔ל וּפֶ֥רַח לְבָנ֖